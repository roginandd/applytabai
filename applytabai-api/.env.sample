# Spring profiles
SPRING_PROFILES_ACTIVE=dev

# Local ports (override per Git worktree when needed)
SPRING_BOOT_PORT=8080
VITE_PORT=5173
POSTGRES_PORT=5432
COMPOSE_PROJECT_NAME=my-spring-boot-app
SPRING_DOCKER_COMPOSE_ENABLED=false

# Database (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:${POSTGRES_PORT}/mydb
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=change-me

# JWT authentication
APP_SECURITY_JWT_SECRET=change-me-to-a-random-32-byte-minimum-secret
APP_SECURITY_JWT_ISSUER=applytabai-api
APP_SECURITY_JWT_ACCESS_TOKEN_TTL=PT15M
APP_SECURITY_JWT_REFRESH_TOKEN_TTL=P7D
APP_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Testcontainers overrides (optional)
TESTCONTAINERS_RYUK_DISABLED=false
